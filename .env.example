# Copy to .env (gitignored) and fill in. Exported environment variables override this file.

# Your proxies, in any format: host:port, host:port:user:pass, user:pass@host:port or user:pass:host:port,
# optionally starting with http://, https:// or socks5://. Several: separate them with commas, spaces or new
# lines, or give the path of a file with one per line. Leave unset to search from your own IP.
#
# Rotating residential: keep the session part ({sid}, or your provider's sid-…/session-…), so every search
# gets a new IP.
GSEARCH_PROXY=user-country-us-sid-{sid}:your-password@gate.example.com:7000

# Stop all proxy traffic after this many MB, counted across runs. Remove the line for no limit.
GSEARCH_DATA_LIMIT_MB=1000

# 1: run the browser without a window behind proxies too. Headless drew more CAPTCHAs on proxy IPs in testing.
# GSEARCH_HEADLESS=1
